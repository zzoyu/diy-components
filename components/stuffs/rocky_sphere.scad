// 자연스러운 측지 정20면체 — 엣지 와이어프레임 (Geodesic Icosahedron Wireframe)
// 42꼭짓점 / 80면의 측지 정20면체에서 면을 제거하고
// 모서리(edge)만 얇은 원통으로, 꼭짓점(vertex)은 작은 구로 출력합니다.
//
// radius     : 기준 반경 (mm)
// roughness  : 꼭짓점 불규칙성 비율 (0 = 완벽한 구형, 0.2 = 매우 울퉁불퉁)
// seed       : 랜덤 시드 (값을 바꾸면 전혀 다른 모양이 됩니다)
// edge_r     : 모서리 원통 반지름 (mm)
// node_r     : 꼭짓점 구 반지름 (mm, 0 이면 구 생략)
// drop_ratio : 제거할 모서리 비율 (0 = 전부 유지, 0.5 = 절반 제거)
// drop_seed  : 모서리 제거용 랜덤 시드 (seed 와 독립)

// 벡터를 단위벡터로 정규화 (구면 투영에 사용)
function vunit(v) = let(l = norm(v)) [v[0]/l, v[1]/l, v[2]/l];

// 두 점 p1 → p2 사이에 원통을 배치하는 모듈
module draw_edge(p1, p2, r) {
    v   = p2 - p1;
    len = norm(v);
    translate(p1)
        rotate([0, acos(v[2] / len), atan2(v[1], v[0])])
            cylinder(h = len, r = r, center = false, $fn = 8);
}

module natural_icosahedron(radius = 20, roughness = 0.10, seed = 42,
                            edge_r = 0.5, node_r = 0.8,
                            drop_ratio = 0.20, drop_seed = 7) {
    phi = (1 + sqrt(5)) / 2;      // 황금비 ≈ 1.618
    n0  = sqrt(1 + phi * phi);    // 꼭짓점 크기 ≈ 1.902

    // ── 기본 꼭짓점 12개 (단위구 위) ────────────────────────────────────────
    base = [
        [-1/n0,  phi/n0,    0   ],  //  0
        [ 1/n0,  phi/n0,    0   ],  //  1
        [-1/n0, -phi/n0,    0   ],  //  2
        [ 1/n0, -phi/n0,    0   ],  //  3
        [    0,  -1/n0,  phi/n0 ],  //  4
        [    0,   1/n0,  phi/n0 ],  //  5
        [    0,  -1/n0, -phi/n0 ],  //  6
        [    0,   1/n0, -phi/n0 ],  //  7
        [ phi/n0,    0,  -1/n0  ],  //  8
        [ phi/n0,    0,   1/n0  ],  //  9
        [-phi/n0,    0,  -1/n0  ],  // 10
        [-phi/n0,    0,   1/n0  ]   // 11
    ];

    // ── 30개 모서리 중점 → 꼭짓점 12~41 ────────────────────────────────────
    // 양 끝 꼭짓점의 합벡터를 정규화 → 구면 위 중점
    edges = [
        [0, 1],[0, 5],[0, 7],[0,10],[0,11],   // → 12–16
        [1, 5],[1, 7],[1, 8],[1, 9],           // → 17–20
        [2, 3],[2, 4],[2, 6],[2,10],[2,11],    // → 21–25
        [3, 4],[3, 6],[3, 8],[3, 9],           // → 26–29
        [4, 5],[4, 9],[4,11],                  // → 30–32
        [5, 9],[5,11],                         // → 33–34
        [6, 7],[6, 8],[6,10],                  // → 35–37
        [7, 8],[7,10],                         // → 38–39
        [8, 9],                                // → 40
        [10,11]                                // → 41
    ];
    mids = [for (e = edges) vunit([
        base[e[0]][0] + base[e[1]][0],
        base[e[0]][1] + base[e[1]][1],
        base[e[0]][2] + base[e[1]][2]
    ])];

    all42 = concat(base, mids);  // 42개 단위구 꼭짓점

    // ── 노이즈 적용 (방향만 흔들고 재정규화 → 구면 위 요철) ────────────────
    // 42꼭짓점 × 3축 = 126개 오프셋
    noise = rands(-roughness, roughness, 126, seed);
    pts   = [for (i = [0:41]) vunit([
        all42[i][0] + noise[i*3  ],
        all42[i][1] + noise[i*3+1],
        all42[i][2] + noise[i*3+2]
    ])];

    // ── 80개 삼각형 면 (원래 20면을 각 4개로 세분화) ────────────────────────
    // 원 면 [a,b,c]에서 중점 mab/mbc/mac을 구하면
    // 4개 서브삼각형: [a,mab,mac], [mab,b,mbc], [mac,mbc,c], [mab,mbc,mac]
    faces = [
        // [0,11,5]  mid(0,11)=16 mid(5,11)=34 mid(0,5)=13
        [ 0,16,13],[16,11,34],[13,34, 5],[16,34,13],
        // [0,5,1]   mid(0,5)=13  mid(1,5)=17  mid(0,1)=12
        [ 0,13,12],[13, 5,17],[12,17, 1],[13,17,12],
        // [0,1,7]   mid(0,1)=12  mid(1,7)=18  mid(0,7)=14
        [ 0,12,14],[12, 1,18],[14,18, 7],[12,18,14],
        // [0,7,10]  mid(0,7)=14  mid(7,10)=39 mid(0,10)=15
        [ 0,14,15],[14, 7,39],[15,39,10],[14,39,15],
        // [0,10,11] mid(0,10)=15 mid(10,11)=41 mid(0,11)=16
        [ 0,15,16],[15,10,41],[16,41,11],[15,41,16],
        // [1,5,9]   mid(1,5)=17  mid(5,9)=33  mid(1,9)=20
        [ 1,17,20],[17, 5,33],[20,33, 9],[17,33,20],
        // [5,11,4]  mid(5,11)=34 mid(4,11)=32 mid(4,5)=30
        [ 5,34,30],[34,11,32],[30,32, 4],[34,32,30],
        // [11,10,2] mid(10,11)=41 mid(2,10)=24 mid(2,11)=25
        [11,41,25],[41,10,24],[25,24, 2],[41,24,25],
        // [10,7,6]  mid(7,10)=39 mid(6,7)=35  mid(6,10)=37
        [10,39,37],[39, 7,35],[37,35, 6],[39,35,37],
        // [7,1,8]   mid(1,7)=18  mid(1,8)=19  mid(7,8)=38
        [ 7,18,38],[18, 1,19],[38,19, 8],[18,19,38],
        // [3,9,4]   mid(3,9)=29  mid(4,9)=31  mid(3,4)=26
        [ 3,29,26],[29, 9,31],[26,31, 4],[29,31,26],
        // [3,4,2]   mid(3,4)=26  mid(2,4)=22  mid(2,3)=21
        [ 3,26,21],[26, 4,22],[21,22, 2],[26,22,21],
        // [3,2,6]   mid(2,3)=21  mid(2,6)=23  mid(3,6)=27
        [ 3,21,27],[21, 2,23],[27,23, 6],[21,23,27],
        // [3,6,8]   mid(3,6)=27  mid(6,8)=36  mid(3,8)=28
        [ 3,27,28],[27, 6,36],[28,36, 8],[27,36,28],
        // [3,8,9]   mid(3,8)=28  mid(8,9)=40  mid(3,9)=29
        [ 3,28,29],[28, 8,40],[29,40, 9],[28,40,29],
        // [4,9,5]   mid(4,9)=31  mid(5,9)=33  mid(4,5)=30
        [ 4,31,30],[31, 9,33],[30,33, 5],[31,33,30],
        // [2,4,11]  mid(2,4)=22  mid(4,11)=32 mid(2,11)=25
        [ 2,22,25],[22, 4,32],[25,32,11],[22,32,25],
        // [6,2,10]  mid(2,6)=23  mid(2,10)=24 mid(6,10)=37
        [ 6,23,37],[23, 2,24],[37,24,10],[23,24,37],
        // [8,6,7]   mid(6,8)=36  mid(6,7)=35  mid(7,8)=38
        [ 8,36,38],[36, 6,35],[38,35, 7],[36,35,38],
        // [9,8,1]   mid(8,9)=40  mid(1,8)=19  mid(1,9)=20
        [ 9,40,20],[40, 8,19],[20,19, 1],[40,19,20]
    ];

    // ── 모서리 렌더링 (대각선 간선만 랜덤 제거) ──────────────────────────────
    // 꼭짓점 인덱스 0~11  : 기본 정20면체 꼭짓점 → 관련 간선은 항상 유지
    // 꼭짓점 인덱스 12~41 : 세분화 중간점   → 양 끝이 모두 중간점인 간선만 제거 대상
    //
    // edge_drop[min*42+max] : 각 간선에 대한 일관된 랜덤 값
    // (같은 간선이 두 면에서 등장해도 항상 동일한 판단을 내림)
    edge_drop = rands(0, 1, 42 * 42, drop_seed);
    for (fi = [0 : len(faces) - 1]) {
        f = faces[fi];
        for (ei = [0 : 2]) {
            a = f[ei];
            b = f[(ei + 1) % 3];
            mn = min(a, b);
            mx = max(a, b);
            // mn >= 12 이면 mx 도 반드시 >= 12 (양 끝이 모두 중간점 = 대각선)
            is_diag = (mn >= 12);
            if (!is_diag || edge_drop[mn * 42 + mx] >= drop_ratio)
                draw_edge(pts[a] * radius, pts[b] * radius, edge_r);
        }
    }

    // ── 꼭짓점에 작은 구 배치 (연결부 마감) ───────────────────────────────────
    if (node_r > 0) {
        for (p = pts)
            translate(p * radius) sphere(r = node_r, $fn = 10);
    }
}

// ── 렌더링 ──────────────────────────────────────────────────────────────────
// F5: 빠른 미리보기  /  F6: 정밀 렌더링  /  F7: STL 내보내기
natural_icosahedron(radius = 20, roughness = 0.20, seed = 37,
                    edge_r = 0.2, node_r = 0.2,
                    drop_ratio = 0.2, drop_seed = 2);